# Copy to .env.local to override locally. Never commit real secrets.

# Where the data is kept:
#   localStorage  in this browser only (default, also used by the public demo)
#   api           on the JalaSpace API, shared by every browser; needs VITE_API_URL
# Vite reads this when the dev server starts or the app is built, so restart after changing it.
VITE_DATA_PROVIDER=localStorage

# Base URL of the JalaSpace API. Required for VITE_DATA_PROVIDER=api. Unset with
# localStorage: features that need the API, such as AI maintenance suggestions, are not offered.
# VITE_API_URL=http://localhost:3000
