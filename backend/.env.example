# Copy to .env for local overrides. Never commit real secrets.
# Port and interface the API listens on.
PORT=3000
HOST=0.0.0.0
# true: start with the demo data and enable POST /api/demo/reset.
SEED_DEMO_DATA=true

# AI maintenance suggestions (Gemini API free tier). Without a key the feature is off.
# The key is a secret: keep it in .env or the hosting platform, never in git.
GEMINI_API_KEY=
# Optional: defaults to gemini-3.5-flash-lite.
GEMINI_MODEL=
# Origins allowed to call the API from a browser, comma-separated. `*` matches part of
# one host label, e.g. https://jalaspace-*-team.vercel.app for Vercel previews.
CORS_ORIGINS=http://localhost:5173
# Number of proxies in front of the API, so rate limits see the real client IP (Render: 1).
TRUST_PROXY=0
