#!/usr/bin/env bash
# Shortcuts for the Docker Compose development setup, e.g. `./dev up`.
# Run `./dev help` for the commands.
set -euo pipefail

cd "$(dirname "$0")"

SERVICES=(frontend backend)

usage() {
  cat <<'EOF'
Usage: ./dev <command> [service] [args]

Without a service, commands act on both frontend and backend (shell defaults to frontend).

  up [service]         Start in the background and print the URLs
  down [service]       Stop and remove the containers
  restart [service]    Recreate the containers, so docker-compose.yml and env changes apply
  rebuild [service]    Rebuild the images and node_modules, e.g. after package-lock.json changes
  logs [service]       Follow the logs
  ps                   Show the containers and their state
  shell [service]      Open a shell in a container (default: frontend)
  exec <service> <cmd> Run a command in a container, e.g. ./dev exec backend npm outdated
  lint [service]       Run lint
  typecheck [service]  Run the TypeScript check
  test [service]       Run the unit tests
  check [service]      Run lint, typecheck and tests
  clean                Stop and remove the containers and their node_modules volumes
  deploy [args]        Deploy the backend in this working copy to Cloud Run (needs gcloud) with the
                       variables in backend/cloud-run.env.yaml; args go to gcloud run deploy,
                       e.g. ./dev deploy --quiet
  cloud-env list       Show the Cloud Run service's environment variables (secrets by name only)
  cloud-env set KEY=VALUE...
                       Add or change environment variables until the next deploy, e.g. to try a
                       value; to keep it, change backend/cloud-run.env.yaml instead
  cloud-env unset KEY...
                       Remove environment variables until the next deploy
  cloud-env secret KEY Ask for a value without showing it, store it in Secret Manager and
                       give it to the service as KEY, e.g. ./dev cloud-env secret GEMINI_API_KEY
                       Each change starts a new revision, which restores the demo data.
  help                 Show this help

Commands that run npm scripts use the running container, or a temporary one when it is stopped.
End-to-end tests run on the host: cd frontend && npm run test:e2e
EOF
}

die() {
  echo "dev: $*" >&2
  exit 1
}

compose() {
  docker compose "$@"
}

is_service() {
  local name
  for name in "${SERVICES[@]}"; do
    [[ $name == "$1" ]] && return 0
  done
  return 1
}

# Sets TARGETS to the services to act on: the one given, or all of them.
TARGETS=()
set_targets() {
  if [[ -z ${1:-} ]]; then
    TARGETS=("${SERVICES[@]}")
  elif is_service "$1"; then
    TARGETS=("$1")
  else
    die "unknown service '$1' (expected: ${SERVICES[*]})"
  fi
}

# Runs a command in the service's container, or in a temporary one when it isn't running.
in_service() {
  local service=$1
  shift
  local tty=()
  [[ -t 0 && -t 1 ]] || tty=(-T)
  if [[ -n $(compose ps --status running --quiet "$service") ]]; then
    compose exec "${tty[@]}" "$service" "$@"
  else
    compose run --rm --no-deps "${tty[@]}" "$service" "$@"
  fi
}

# Runs npm scripts in each target service, e.g. run_scripts lint typecheck.
run_scripts() {
  local service script
  for service in "${TARGETS[@]}"; do
    for script in "$@"; do
      echo "▶ $service: npm run $script"
      in_service "$service" npm run "$script"
    done
  done
}

print_urls() {
  echo
  echo "App:  http://localhost:5173"
  echo "API:  http://localhost:3000/api/health"
  echo "Logs: ./dev logs"
}

cmd=${1:-help}
shift || true

# Cloud Run commands use gcloud's active project instead of Docker. Environment
# variables belong to the service, so their names need no prefix; secret names are
# project-wide, so they start with jalaspace-.
CLOUD_RUN_SERVICE=${CLOUD_RUN_SERVICE:-jalaspace-backend}
CLOUD_RUN_REGION=${CLOUD_RUN_REGION:-europe-north1}
# The service's variables and secret references, as deploy.yml sets them.
CLOUD_RUN_ENV_FILE=backend/cloud-run.env.yaml
CLOUD_RUN_SECRETS=GEMINI_API_KEY=jalaspace-gemini-api-key:latest

# Changes made by hand last only until the next deploy.
warn_env_file() {
  echo "Note: the next deploy sets the variables in $CLOUD_RUN_ENV_FILE again; change that file to keep this." >&2
}

gcloud_project() {
  command -v gcloud >/dev/null || die "gcloud is not installed"
  PROJECT=$(gcloud config get-value project 2>/dev/null)
  [[ -n $PROJECT ]] || die "no gcloud project; run: gcloud config set project <project-id>"
}

# Runs gcloud run services <command> for the service, e.g. run_service update --update-env-vars A=1.
run_service() {
  local command=$1
  shift
  gcloud run services "$command" "$CLOUD_RUN_SERVICE" --project "$PROJECT" --region "$CLOUD_RUN_REGION" "$@"
}

is_env_key() {
  [[ $1 =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]
}

cloud_env() {
  local action=${1:-list}
  shift || true
  gcloud_project
  case $action in
    list)
      # Plain variables with their values; secrets show the secret's name, never its value.
      run_service describe --format=json | node -e '
        let json = ""
        process.stdin.on("data", (chunk) => (json += chunk)).on("end", () => {
          const env = JSON.parse(json).spec.template.spec.containers[0].env ?? []
          for (const { name, value, valueFrom } of env) {
            const ref = valueFrom?.secretKeyRef
            console.log(ref ? `${name}  (secret ${ref.name}:${ref.key})` : `${name}=${value ?? ""}`)
          }
        })'
      ;;
    set)
      [[ $# -ge 1 ]] || die "usage: ./dev cloud-env set KEY=VALUE..."
      local pair flags=()
      for pair in "$@"; do
        [[ $pair == *=* ]] && is_env_key "${pair%%=*}" || die "expected KEY=VALUE, got '$pair'"
        # ^@@^ makes @@ the separator, so values may contain commas (e.g. CORS_ORIGINS).
        flags+=(--update-env-vars "^@@^$pair")
      done
      echo "Updating $CLOUD_RUN_SERVICE (project $PROJECT): ${*%%=*}"
      run_service update "${flags[@]}"
      warn_env_file
      ;;
    unset)
      [[ $# -ge 1 ]] || die "usage: ./dev cloud-env unset KEY..."
      local key
      for key in "$@"; do is_env_key "$key" || die "not a variable name: '$key'"; done
      run_service update --remove-env-vars "$(IFS=,; echo "$*")"
      warn_env_file
      ;;
    secret)
      [[ $# -eq 1 ]] && is_env_key "$1" || die "usage: ./dev cloud-env secret KEY"
      local key=$1 secret value account
      # GEMINI_API_KEY → jalaspace-gemini-api-key
      secret="jalaspace-$(tr '[:upper:]_' '[:lower:]-' <<<"$key")"
      read -rsp "Value for $key (not shown): " value
      echo
      [[ -n $value ]] || die "empty value"
      gcloud services enable secretmanager.googleapis.com --project "$PROJECT"
      if gcloud secrets describe "$secret" --project "$PROJECT" >/dev/null 2>&1; then
        printf %s "$value" | gcloud secrets versions add "$secret" --project "$PROJECT" --data-file=-
      else
        printf %s "$value" | gcloud secrets create "$secret" --project "$PROJECT" --replication-policy=automatic --data-file=-
        # The service runs as its own account, or as the Compute Engine default account.
        account=$(run_service describe --format='value(spec.template.spec.serviceAccountName)')
        [[ -n $account ]] || account="$(gcloud projects describe "$PROJECT" --format='value(projectNumber)')-compute@developer.gserviceaccount.com"
        gcloud secrets add-iam-policy-binding "$secret" --project "$PROJECT" \
          --member="serviceAccount:$account" --role=roles/secretmanager.secretAccessor --format=none
      fi
      unset value
      # A plain variable with the same name must go first; gcloud cannot turn it into a secret.
      run_service update --update-secrets "$key=$secret:latest"
      [[ ,$CLOUD_RUN_SECRETS, == *,$key=* ]] ||
        echo "Note: add $key=$secret:latest to SECRETS in .github/workflows/deploy.yml and CLOUD_RUN_SECRETS in dev." >&2
      ;;
    *)
      die "usage: ./dev cloud-env list|set|unset|secret"
      ;;
  esac
}

# Builds backend/Dockerfile with Cloud Build and deploys a new revision to Cloud Run with
# the variables in CLOUD_RUN_ENV_FILE and the secrets in CLOUD_RUN_SECRETS, as deploy.yml does.
# The service keeps its other settings (instances, CPU, memory).
if [[ $cmd == deploy ]]; then
  gcloud_project
  echo "Deploying $CLOUD_RUN_SERVICE to Cloud Run (project $PROJECT, region $CLOUD_RUN_REGION)."
  exec gcloud run deploy "$CLOUD_RUN_SERVICE" --source backend --region "$CLOUD_RUN_REGION" \
    --env-vars-file "$CLOUD_RUN_ENV_FILE" --update-secrets "$CLOUD_RUN_SECRETS" "$@"
fi

if [[ $cmd == cloud-env ]]; then
  cloud_env "$@"
  exit
fi

command -v docker >/dev/null || die "docker is not installed"

case $cmd in
  up)
    set_targets "${1:-}"
    compose up -d "${TARGETS[@]}"
    print_urls
    ;;
  down)
    if [[ -n ${1:-} ]]; then
      set_targets "$1"
      compose down "${TARGETS[@]}"
    else
      compose down
    fi
    ;;
  restart)
    set_targets "${1:-}"
    # New containers, like down + up, but the node_modules volumes and the network are kept.
    compose up -d --force-recreate "${TARGETS[@]}"
    print_urls
    ;;
  rebuild)
    set_targets "${1:-}"
    # -V recreates the node_modules volumes, so new dependencies are picked up.
    compose up -d --build -V "${TARGETS[@]}"
    print_urls
    ;;
  logs)
    set_targets "${1:-}"
    compose logs -f "${TARGETS[@]}"
    ;;
  ps | status)
    compose ps
    ;;
  shell | sh)
    set_targets "${1:-frontend}"
    in_service "${TARGETS[0]}" sh
    ;;
  exec)
    [[ $# -ge 2 ]] || die "usage: ./dev exec <service> <command>"
    set_targets "$1"
    shift
    in_service "${TARGETS[0]}" "$@"
    ;;
  lint | typecheck | test)
    set_targets "${1:-}"
    run_scripts "$cmd"
    ;;
  check)
    set_targets "${1:-}"
    run_scripts lint typecheck test
    ;;
  clean)
    # Removes the containers and their anonymous node_modules volumes; source files are untouched.
    compose down --volumes --remove-orphans
    ;;
  help | -h | --help)
    usage
    ;;
  *)
    usage >&2
    die "unknown command '$cmd'"
    ;;
esac
